# --- Required -----------------------------------------------------------
# MongoDB Atlas connection string (include a database name, e.g. /ej-remodeling)
MONGODB_URI=
# Random string, 32+ characters (openssl rand -hex 32). Signs session tokens and rate-limit keys.
AUTH_SECRET=
# Public origin, no trailing slash. Used for canonical URLs, Stripe redirects and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- First admin account (only read while no admin exists; remove afterwards)
ADMIN_EMAIL=
# 12 to 72 characters
ADMIN_INITIAL_PASSWORD=

# --- Stripe (online payments stay disabled until the secret key and webhook secret are set)
STRIPE_SECRET_KEY=
# Reserved for embedded Stripe elements; hosted Checkout does not need it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional; submissions are always stored even when blank) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
